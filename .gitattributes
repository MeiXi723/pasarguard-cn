# 强制 shell 脚本用 LF —— CRLF 会让 bash 报 \$'\r': command not found
*.sh       text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
.gitignore text eol=lf
LICENSE    text eol=lf

# Windows 专用脚本才用 CRLF
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf